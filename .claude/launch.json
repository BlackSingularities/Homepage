{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "homepage",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 5173,
      "autoPort": true
    },
    {
      "name": "api",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "server/index.mjs"
      ],
      "env": {
        "SETTINGS_ENCRYPTION_KEY": "dev-secret",
        "DATA_DIR": "./data",
        "PORT": "3001",
        "SITE_TEMPLATE_URL": "http://localhost:5173/index.html"
      },
      "port": 3001
    }
  ]
}
